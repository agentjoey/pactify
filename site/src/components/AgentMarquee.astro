---
const agents = [
  ['CC', 'Claude Code', 'one-click plugin', '#d97757', 'claude-code'],
  ['OC', 'opencode', 'auto-wired', null, 'opencode'],
  ['GM', 'Gemini CLI', 'auto-wired', '#8ab4ff', 'gemini-cli'],
  ['CX', 'Codex CLI', 'config snippet', null, 'codex-cli'],
  ['CD', 'Claude Desktop', '--project rooting', '#d97757', 'claude-desktop'],
  ['AG', 'Antigravity', '--project rooting', '#8ab4ff', 'antigravity'],
];
---
<section class="sec">
  <div class="sec-label">Bring your own agents</div>
  <h2 class="sec-h2">Wired in one command.</h2>
  <div class="mq">
    <div class="mq-track">
      {[...agents, ...agents].map(([lg, name, how, color, id], i) => (
        <a
          class="mq-card"
          href={`/onboarding#${id}`}
          aria-hidden={i >= agents.length ? 'true' : undefined}
          tabindex={i >= agents.length ? -1 : undefined}
        >
          <div class="lg" style={color ? `color:${color}` : undefined}>{lg}</div>
          <div><h3>{name}</h3><p>{how}</p></div>
          <span class="go">setup →</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .mq { overflow: hidden; position: relative; -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); }
  .mq-track { display: flex; width: max-content; padding: 4px 0; }
  .mq-card { width: 200px; margin-right: 14px; border: 1px solid var(--line); border-radius: 11px; padding: 15px; background: var(--bg2); display: flex; align-items: center; gap: 11px; flex-shrink: 0; transition: border-color .2s, transform .2s; }
  .mq-card:hover { border-color: var(--line2); transform: translateY(-3px); }
  .mq-card:hover .go,
  .mq-card:focus-visible .go { opacity: 1; }
  .mq-card .lg { width: 34px; height: 34px; border-radius: 9px; display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: 600; background: var(--bg3); border: 1px solid var(--line2); color: var(--fg); flex-shrink: 0; }
  .mq-card h3 { margin: 0; font-size: 11.5px; color: var(--bright); font-weight: 600; }
  .mq-card p { margin: 2px 0 0; font-size: 9.5px; color: var(--dimmer); }
  .mq-card .go { margin-left: auto; font-size: 10px; color: var(--blue); opacity: 0; transition: opacity .2s; }

  @media (prefers-reduced-motion: no-preference) {
    .mq-track { animation: mqScroll 26s linear infinite; }
    .mq:hover .mq-track,
    .mq:focus-within .mq-track { animation-play-state: paused; }
    @keyframes mqScroll { to { transform: translateX(-50%); } }
  }
</style>
