{
  "nodes": [
    {
      "id": "file:cloud/wire/src/envelope.ts",
      "type": "file",
      "name": "envelope.ts",
      "filePath": "cloud/wire/src/envelope.ts",
      "summary": "Defines the E2E encrypted envelope shape: an opaque ciphertext blob (xchacha20poly1305 nonce+ct) wrapped in a cleartext-header wire message that the relay can route without breaking zero-knowledge.",
      "tags": ["wire-protocol", "schema", "type-definition", "encryption", "zod"],
      "complexity": "simple"
    },
    {
      "id": "file:cloud/wire/src/events.ts",
      "type": "file",
      "name": "events.ts",
      "filePath": "cloud/wire/src/events.ts",
      "summary": "Defines the normalized AgentEvent discriminated union — the plaintext bodies linxd encrypts, covering messages, deltas, thinking, tool calls/results, diffs, approvals, state changes, usage, todos, and reply payloads.",
      "tags": ["wire-protocol", "schema", "type-definition", "event-handler", "zod"],
      "complexity": "moderate"
    },
    {
      "id": "file:cloud/wire/src/machine.ts",
      "type": "file",
      "name": "machine.ts",
      "filePath": "cloud/wire/src/machine.ts",
      "summary": "Defines cleartext-operational MachineInfo metadata (host, agent kinds, workdirs, presence) so the relay can render the machine picker without inspecting encrypted bodies.",
      "tags": ["wire-protocol", "schema", "type-definition", "zod", "metadata"],
      "complexity": "simple"
    },
    {
      "id": "file:cloud/wire/src/operational.ts",
      "type": "file",
      "name": "operational.ts",
      "filePath": "cloud/wire/src/operational.ts",
      "summary": "Defines the cleartext operational header (RunState, EventKind, OperationalHeader) — machine-readable enums, counters, and ids the relay indexes to drive the fleet board, approval inbox, and push.",
      "tags": ["wire-protocol", "schema", "type-definition", "header", "zod"],
      "complexity": "moderate"
    },
    {
      "id": "file:cloud/wire/src/reply.ts",
      "type": "file",
      "name": "reply.ts",
      "filePath": "cloud/wire/src/reply.ts",
      "summary": "Defines E2E reply event bodies (file-list, controls, mcp, discovered, dir-list, command-list) couried as encrypted AgentEvents through the acct room and matched by requestId.",
      "tags": ["wire-protocol", "schema", "type-definition", "rpc-reply", "zod"],
      "complexity": "moderate"
    },
    {
      "id": "file:cloud/wire/src/rpc.ts",
      "type": "file",
      "name": "rpc.ts",
      "filePath": "cloud/wire/src/rpc.ts",
      "summary": "Defines the full client→relay RpcRequest discriminated union covering linx machine RPCs (spawn/send/abort/takeover/list-files/...) plus additive pactify verbs (pact.assign/accept/changes/merge/checkpoint) and multi-machine orchestration (orchestrate, plan, provision).",
      "tags": ["wire-protocol", "schema", "type-definition", "rpc", "zod"],
      "complexity": "complex"
    },
    {
      "id": "file:cloud/wire/src/summary.ts",
      "type": "file",
      "name": "summary.ts",
      "filePath": "cloud/wire/src/summary.ts",
      "summary": "Defines the cleartext fleet-board RunSummary (folded from the operational header) and a wire-local mirror of BackendCapabilitiesLite — what the relay indexes and pushes to drive tiles and the inbox.",
      "tags": ["wire-protocol", "schema", "type-definition", "summary", "zod"],
      "complexity": "moderate"
    },
    {
