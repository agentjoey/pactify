---
const feats = [
  ['⎇', 'var(--role-dev)', 'Git-native', 'The log lives in your repo. Diffable, auditable, recoverable — no server, no database.', 'protocol spec →'],
  ['§', 'var(--role-product)', 'Enforced, not prompted', 'The two rules live in the engine. A worker literally cannot self-accept.', 'the two rules →'],
  ['⌁', 'var(--role-design)', 'Any agent, one protocol', 'MCP tools + CLI fallback. One contract for every agent.', 'onboarding →'],
  ['◎', 'var(--role-dev)', 'Observable', 'pactify serve streams every event to a live dashboard. Watch your squad work.', 'dashboard →'],
];
---
<section class="sec">
  <div class="sec-label">Why pact</div>
  <div class="feats">
    {feats.map(([ic, color, title, body, link]) => (
      <div class="feat">
        <div class="ic" style={`color:${color}`}>{ic}</div>
        <h4>{title}</h4>
        <p>{body}</p>
        <a href="#">{link}</a>
      </div>
    ))}
  </div>
</section>

<style>
  .sec { padding: 46px 30px; border-top: 1px solid var(--line); position: relative; }
  .feats { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 14px; max-width: 860px; margin: 0 auto; }
  .feat { border: 1px solid var(--line); border-radius: 11px; padding: 18px; background: var(--bg2); }
  .feat .ic { width: 30px; height: 30px; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 14px; margin-bottom: 11px; background: var(--bg3); border: 1px solid var(--line2); }
  .feat h4 { margin: 0 0 5px; font-size: 13px; color: var(--bright); font-weight: 600; }
  .feat p { margin: 0 0 9px; font-size: 11px; color: var(--dim); line-height: 1.6; }
  .feat a { font-size: 10.5px; }
</style>
