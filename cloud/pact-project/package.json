{
  "name": "@pactify-apps/pact-project",
  "version": "0.1.0",
  "description": "Pure-TS pact log projection: events → State (Go parity).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
