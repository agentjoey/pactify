{
  "name": "@pactify-apps/crypto",
  "version": "0.1.0",
  "description": "Shared cryptography: key derivation, event encryption & relay-blind pairing for Linx.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -w -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@noble/ciphers": "^1.3.0",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@pactify-apps/wire": "workspace:*",
    "@scure/base": "^1.2.6"
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  }
}
