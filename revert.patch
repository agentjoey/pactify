+func TestListMissing(t *testing.T) {
+	bin := buildBinary(t)
+	dir := t.TempDir()
+	t.Setenv("PACTIFY_HOME", dir)
+
+	healthy := filepath.Join(dir, "healthy")
+	os.MkdirAll(filepath.Join(healthy, ".pact"), 0o755)
+	missing := filepath.Join(dir, "missing")
+
+	run := func(args ...string) string {
+		c := exec.Command(bin, args...)
+		c.Dir = dir // IMPORTANT to avoid modifying repo state
+		out, err := c.CombinedOutput()
+		if err != nil {
+			t.Fatalf("%v: %v %s", args, err, out)
+		}
+		return string(out)
+	}
+
+	run("register", healthy, "--name", "h1")
+	run("register", missing, "--name", "m1")
+
+	s := run("list")
+	lines := strings.Split(strings.TrimSpace(s), "\n")
+	var hLine, mLine string
+	for _, l := range lines {
+		if strings.HasPrefix(l, "h1\t") {
+			hLine = l
+		} else if strings.HasPrefix(l, "m1\t") {
+			mLine = l
+		}
+	}
+
+	if hLine == "" || mLine == "" {
+		t.Fatalf("did not find h1/m1: %q", s)
+	}
+	if strings.Contains(hLine, "(missing") {
+		t.Errorf("healthy project has '(missing': %q", hLine)
+	}
+	if !strings.Contains(mLine, "(missing — no .pact/ at this path; \`pactify unregister m1\` to remove)") {
+		t.Errorf("missing project wrong text: %q", mLine)
+	}
+}
