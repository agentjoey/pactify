---
import Base from '../layouts/Base.astro';

// Product introduction — modeled on Dify's docs intro: a one-line definition,
// a hero visual, a grid of action-oriented navigation cards (multiple entry
// points for different intents), and a closing personality note. Faithful to
// the site's dark mono design tokens (global.css).

const cards = [
  ['◷', 'var(--role-dev)', 'Quick Start',
   'Wire your first squad and ship a feature in minutes.', '/onboarding'],
  ['§', 'var(--role-product)', 'The Protocol',
   'The append-only log and the two rules that make it real.', '/protocol'],
  ['⤓', 'var(--role-design)', 'Install',
   'One curl on your own machine — zero servers, zero database.', '/install.sh'],
  ['◎', 'var(--role-dev)', 'Live Dashboard',
   'pactify serve streams every event — watch your squad work.', 'https://github.com/agentjoey/pactify#readme'],
  ['⌁', 'var(--role-design)', 'Agent roster',
   'Claude Code, opencode, Codex, Gemini, Kimi — one contract each.', '/onboarding'],
  ['↻', 'var(--role-product)', 'Changelog',
   "What's shipped across releases.", 'https://github.com/agentjoey/pactify/releases'],
];
---
<Base title="Introduction — pactify" description="Pactify is a git-native coordination protocol for AI agents: any agent takes a seat, an append-only log enforces review, features ship only when every task is accepted.">
  <main>
    <!-- WHAT IT IS -->
    <section class="intro-hero">
      <div class="intro-eyebrow">Introduction</div>
      <h1 class="intro-h1">Pactify — agents, in agreement.</h1>
      <p class="intro-def">
        <b>Pactify is an open-source coordination protocol for AI agents.</b> Any
        agent that can read a file takes a seat in your repo; an append-only log
        records every move; review is enforced by the engine, not requested in a
        prompt; and a feature ships only once every task is accepted. No server,
        no database — your git history is the source of truth.
      </p>
    </section>

    <!-- VISUAL CONTEXT — the pact log, in the site's own aesthetic -->
    <section class="intro-figwrap">
      <figure class="intro-fig" aria-label="A pact log driving three seats from assigned to shipped">
        <div class="fig-bar"><span class="dot"></span><span class="dot"></span><span class="dot"></span><span class="fig-title">.pact / log.jsonl</span></div>
        <div class="fig-body">
          <div class="fig-seats">
            <span class="seat-chip" style="--c:var(--role-product)">product</span>
            <span class="seat-chip" style="--c:var(--role-design)">design</span>
            <span class="seat-chip" style="--c:var(--role-dev)">dev</span>
          </div>
          <pre class="fig-log"><span class="ll"><span class="t-dim">init</span>    F1 · relay-handoff</span>
<span class="ll"><span class="t-yellow">assign</span>  T1 → <span class="t-green">dev</span>   reviewer <span class="t-blue">design</span></span>
<span class="ll"><span class="t-green">join</span>    dev · branch feat/t1</span>
<span class="ll"><span class="t-blue">checkpoint</span> T1 → awaiting_review</span>
<span class="ll"><span class="t-blue">accept</span>  T1 · design ✓  <span class="t-dim">(worker cannot self-accept)</span></span>
<span class="ll"><span class="t-green">merge</span>   F1 <span class="t-green">shipped</span> — every task accepted</span></pre>
        </div>
      </figure>
    </section>

    <!-- HOW TO PROCEED — multiple entry points -->
    <section class="sec">
      <div class="sec-label">Where to go next</div>
      <div class="intro-cards">
        {cards.map(([ic, color, title, body, href]) => (
          <a class="intro-card" href={href}>
            <div class="ic" style={`color:${color}`}>{ic}</div>
            <h3>{title}</h3>
            <p>{body}</p>
          </a>
        ))}
      </div>
    </section>

    <!-- PERSONALITY -->
    <section class="intro-note">
      <p>
        The name <b>Pactify</b> is <span class="t-green">pact</span> +
        <span class="t-blue">-ify</span> — to turn coordination into a
        <b>pact</b>: a contract your agents ratify and the engine upholds, not a
        prompt they might quietly ignore.
      </p>
    </section>
  </main>

  <style>
    .intro-hero { text-align: center; padding: 56px 24px 26px; }
    .intro-eyebrow { font-size: 10px; letter-spacing: 2px; color: var(--dimmer); text-transform: uppercase; margin-bottom: 12px; }
    .intro-h1 { font-size: clamp(26px, 5vw, 30px); margin: 0; color: var(--bright); font-weight: 600; letter-spacing: -.5px; }
    .intro-def { color: var(--dim); font-size: 13px; line-height: 1.85; max-width: 580px; margin: 18px auto 0; }
    .intro-def b { color: var(--fg); font-weight: 600; }

    .intro-figwrap { padding: 8px 24px 12px; }
    .intro-fig { max-width: 560px; margin: 0 auto; background: var(--bg2); border: 1px solid var(--line); border-radius: 12px; overflow: hidden; box-shadow: 0 18px 50px rgba(0, 0, 0, .45); }
    .fig-bar { display: flex; align-items: center; gap: 7px; padding: 10px 14px; border-bottom: 1px solid var(--line); background: var(--bg3); }
    .fig-bar .dot { width: 9px; height: 9px; border-radius: 50%; background: var(--line2); }
    .fig-title { margin-left: 8px; font-size: 11px; color: var(--dim); }
    .fig-body { padding: 16px 18px 18px; }
    .fig-seats { display: flex; gap: 8px; margin-bottom: 14px; }
    .seat-chip { font-size: 10.5px; color: var(--c); border: 1px solid color-mix(in srgb, var(--c) 40%, transparent); border-radius: 6px; padding: 3px 10px; background: color-mix(in srgb, var(--c) 9%, transparent); }
    .fig-log { margin: 0; font-size: 11.5px; line-height: 2; color: var(--fg); white-space: pre; overflow-x: auto; }
    .fig-log .ll { display: block; }
    .t-green { color: var(--green); } .t-blue { color: var(--blue); } .t-yellow { color: var(--yellow); } .t-dim { color: var(--dimmer); }

    .intro-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 14px; max-width: 860px; margin: 0 auto; }
    .intro-card { border: 1px solid var(--line); border-radius: 12px; padding: 18px; background: var(--bg2); display: block; transition: border-color .15s ease, transform .15s ease; }
    .intro-card:hover { border-color: var(--line2); transform: translateY(-2px); text-decoration: none; }
    .intro-card .ic { width: 32px; height: 32px; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 15px; margin-bottom: 12px; background: var(--bg3); border: 1px solid var(--line2); }
    .intro-card h3 { margin: 0 0 5px; font-size: 13.5px; color: var(--bright); font-weight: 600; }
    .intro-card p { margin: 0; font-size: 11.5px; color: var(--dim); line-height: 1.6; }

    .intro-note { text-align: center; padding: 30px 24px 8px; }
    .intro-note p { max-width: 540px; margin: 0 auto; font-size: 12px; color: var(--dim); line-height: 1.8; }
    .intro-note b { color: var(--fg); }
  </style>
</Base>
