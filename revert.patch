+func TestAPIProjectsMissing(t *testing.T) {
+	dir := t.TempDir()
+	healthyPath := filepath.Join(dir, "healthy")
+	seedProject(t, healthyPath, "h1")
+	missingPath := filepath.Join(dir, "missing")
+	
+	srv := New([]registry.Project{
+		{Name: "h1", Path: healthyPath},
+		{Name: "m1", Path: missingPath},
+	})
+	ts := httptest.NewServer(srv.Handler())
+	defer ts.Close()
+
+	resp, _ := http.Get(ts.URL + "/api/projects")
+	var projects []map[string]any
+	json.NewDecoder(resp.Body).Decode(&projects)
+	resp.Body.Close()
+
+	var hProj, mProj map[string]any
+	for _, p := range projects {
+		if p["name"] == "h1" {
+			hProj = p
+		} else if p["name"] == "m1" {
+			mProj = p
+		}
+	}
+	if hProj == nil || mProj == nil {
+		t.Fatalf("did not find both in response: %v", projects)
+	}
+	if _, ok := hProj["missing"]; ok {
+		t.Errorf("expected healthy NOT to have 'missing' key: %v", hProj)
+	}
+	if missingVal, ok := mProj["missing"]; !ok || missingVal != true {
+		t.Errorf("expected missing to have 'missing': true, got: %v", mProj)
+	}
