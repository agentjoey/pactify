---
import DocsLayout from './DocsLayout.astro';
const { title, description } = Astro.props;
---
<DocsLayout title={title} description={description}>
  <div class="doc">
    <slot />
  </div>
  <style is:global>
    .doc h1, .doc h2, .doc h3 { color: var(--bright); letter-spacing: -0.3px; }
    .doc h1 { font-size: 26px; border-bottom: 1px solid var(--line); padding-bottom: 10px; }
    .doc h2 { font-size: 19px; margin-top: 36px; }
    .doc pre { background: var(--bg2); border: 1px solid var(--line); border-radius: 8px; padding: 14px 16px; overflow-x: auto; font-size: 12.5px; }
    .doc pre code { background: none; border: none; padding: 0; }
    .doc table { border-collapse: collapse; font-size: 13px; display: block; overflow-x: auto; }
    .doc th, .doc td { border: 1px solid var(--line2); padding: 6px 10px; text-align: left; }
    .doc blockquote { border-left: 3px solid var(--line2); margin-left: 0; padding-left: 14px; color: var(--dim); }
  </style>
</DocsLayout>
