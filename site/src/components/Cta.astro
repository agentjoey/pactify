---
const curl = 'curl -fsSL https://pactify.dev/install.sh | sh';
---
<section class="sec cta">
  <div class="sec-label">Five minutes to a working pact</div>
  <div class="cta-row">
    <button id="cta-copy" data-cmd={curl} title="click to copy" class="cta-code">
      <span class="t-green">$</span> {curl}
    </button>
    <a class="gh2" href="https://github.com/agentjoey/pactify">★ Star on GitHub</a>
  </div>
  <p class="cta-plugin">/plugin marketplace add agentjoey/pactify · /plugin install pact@pactify</p>
</section>

<script>
  const cta = document.getElementById('cta-copy');
  // Capture once, outside the handler — a double-click during the feedback
  // window must never capture '✓ copied' as the thing to restore.
  const original = cta?.innerHTML;
  let timer: ReturnType<typeof setTimeout>;
  cta?.addEventListener('click', async () => {
    const cmd = (cta as HTMLElement).dataset.cmd;
    if (!cmd || !original) return;
    try {
      await navigator.clipboard.writeText(cmd);
      cta.textContent = '✓ copied';
      clearTimeout(timer);
      timer = setTimeout(() => { cta.innerHTML = original; }, 1500);
    } catch {
      /* clipboard unavailable (http/permissions) — leave the command selectable */
    }
  });
</script>

<style>
  .sec { padding: 46px 30px; border-top: 1px solid var(--line); position: relative; }
  .cta { text-align: center; }
  .cta-row { margin-top: 14px; display: flex; gap: 12px; justify-content: center; align-items: center; flex-wrap: wrap; }
  .cta-code { background: var(--bg3); border: 1px solid var(--line2); border-radius: 8px; padding: 9px 16px; font-size: 12px; color: #9fb3c8; font-family: var(--mono); cursor: pointer; max-width: 100%; overflow-wrap: anywhere; text-align: left; }
  .cta-code .t-green { color: var(--green); }
  .gh2 { display: inline-block; border: 1px solid var(--line2); border-radius: 8px; padding: 9px 16px; font-size: 12px; color: var(--fg); }
  .cta-plugin { font-size: 10.5px; color: var(--dimmer); margin: 14px 0 0; }
</style>
