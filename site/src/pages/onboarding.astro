---
import { getEntry, render } from 'astro:content';
import Doc from '../layouts/Doc.astro';
const entry = await getEntry('docs', 'agent-onboarding');
if (!entry) throw new Error('canonical doc not found at ../docs/agent-onboarding.md');
const { Content } = await render(entry);
---
<Doc title="Agent onboarding"><Content /></Doc>
