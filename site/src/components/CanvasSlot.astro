---
const nodes = [
  ['T1 · spec api', 'product agent', 'var(--role-product)', '#7a6536', 'left:4%;top:54px'],
  ['T2 · build engine', 'dev agent A · awaiting_review', 'var(--role-dev)', '#2a4a39', 'left:38%;top:12px'],
  ['T3 · build cli', 'dev agent B · in_progress', 'var(--role-dev)', '#2a4a39', 'left:38%;top:104px'],
  ['review · merge', 'design agent', 'var(--role-design)', '#33476b', 'left:74%;top:54px'],
];
const edges = [
  'left:21%;top:78px;width:16%;transform:rotate(-14deg)',
  'left:21%;top:84px;width:16%;transform:rotate(14deg)',
  'left:60%;top:40px;width:13%;transform:rotate(13deg)',
  'left:60%;top:124px;width:13%;transform:rotate(-13deg)',
];
---
<section class="sec">
  <div class="sec-label">Watch your squad work</div>
  <div class="sec-h2">Live, from the log.</div>
  <div class="canvas">
    <span class="ph">slot · phase 3 canvas / dashboard capture</span>
    <div class="cnodes">
      {nodes.map(([title, who, color, border, pos]) => (
        <div class="cn" style={`${pos};color:${color};border-color:${border}`}>
          <h6 style={`color:${color}`}>{title}</h6><p>{who}</p>
        </div>
      ))}
      {edges.map((e) => (<div class="cedge" style={e}></div>))}
    </div>
    <p class="canvas-cap">v2 上线:serve dashboard 实录 → Phase 3 后:编排画布实录,同框演进</p>
  </div>
</section>

<style>
  .sec { padding: 46px 30px; border-top: 1px solid var(--line); position: relative; }
  .canvas { max-width: 760px; margin: 0 auto; border: 1px dashed #3d4754; border-radius: 14px; background: var(--bg2); padding: 22px; position: relative; overflow: hidden; }
  .canvas .ph { position: absolute; top: 12px; right: 14px; font-size: 8.5px; letter-spacing: 1px; color: var(--dimmer); border: 1px solid var(--line2); border-radius: 99px; padding: 2px 9px; text-transform: uppercase; }
  .cnodes { position: relative; height: 170px; }
  .cn { position: absolute; border-radius: 10px; border: 1.5px solid; background: #101820; padding: 8px 12px; font-size: 10px; }
  .cn h6 { margin: 0; font-size: 10.5px; font-weight: 600; }
  .cn p { margin: 1px 0 0; color: var(--dimmer); font-size: 9px; }
  .cedge { position: absolute; height: 1.5px; background: linear-gradient(90deg, #3d4754, var(--line2)); transform-origin: left center; }
  .canvas-cap { margin: 10px 0 0; text-align: center; font-size: 10px; color: var(--dimmer); }
</style>
