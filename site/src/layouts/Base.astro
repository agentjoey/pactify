---
const { title = 'pactify — agents, in agreement.', description =
  'pact is a git-native coordination protocol for AI agents — append-only log, enforced review, any agent can take a seat.' } = Astro.props;
import '../styles/global.css';
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.url} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style>
      footer .foot-h { margin: 0 0 8px; font-size: 10px; color: var(--dim); letter-spacing: 1px; text-transform: uppercase; font-weight: 400; }
      footer div span { display: block; line-height: 2; }
    </style>
  </head>
  <body>
    <nav class="wrap" style="display:flex;justify-content:space-between;align-items:center;padding-top:18px;padding-bottom:18px;border-bottom:1px solid var(--line);font-size:13px">
      <div>
        <a href="/" style="color:var(--bright);font-weight:600;letter-spacing:.5px">pactify</a>
        <a href="/#ladder" style="color:var(--dim);margin-left:20px">products</a>
        <a href="/protocol" style="color:var(--dim);margin-left:14px">protocol</a>
        <a href="/onboarding" style="color:var(--dim);margin-left:14px">onboarding</a>
        <a href="/protocol" style="color:var(--dim);margin-left:14px">docs</a>
      </div>
      <a href="https://github.com/agentjoey/pactify" style="border:1px solid var(--line2);border-radius:6px;padding:5px 12px;color:var(--fg)">GitHub</a>
    </nav>
    <slot />
    <footer class="wrap" style="display:flex;gap:40px;flex-wrap:wrap;padding-top:26px;padding-bottom:32px;border-top:1px solid var(--line);font-size:10.5px;color:var(--dimmer);margin-top:56px">
      <div>
        <h3 class="foot-h">Product</h3>
        <span><a href="/#ladder" style="color:var(--dimmer)">Base</a></span>
        <span><a href="/#ladder" style="color:var(--dimmer)">Squad (soon)</a></span>
        <span><a href="/#ladder" style="color:var(--dimmer)">Team (planned)</a></span>
      </div>
      <div>
        <h3 class="foot-h">Resources</h3>
        <span><a href="/protocol" style="color:var(--dimmer)">Protocol spec</a></span>
        <span><a href="/onboarding" style="color:var(--dimmer)">Agent onboarding</a></span>
        <span><a href="/install.sh" style="color:var(--dimmer)">Install</a></span>
      </div>
      <div>
        <h3 class="foot-h">Community</h3>
        <span><a href="https://github.com/agentjoey/pactify" style="color:var(--dimmer)">GitHub</a></span>
        <span><a href="https://github.com/agentjoey/pactify/issues" style="color:var(--dimmer)">Issues</a></span>
        <span><a href="https://github.com/agentjoey/pactify/releases" style="color:var(--dimmer)">Releases</a></span>
      </div>
      <div style="margin-left:auto;text-align:right">
        <h3 class="foot-h">pactify</h3>
        <span>MIT · protocol v1 frozen</span>
        <span>© 2026 agentjoey</span>
      </div>
    </footer>
  </body>
</html>
